container {
    slot('input') {
        pos(7,8)
    }
    playerslots(27,102)
}
window {
    size(194,184)

    event('redstone','booster.setRsMode')

    panel('','positional') {
        bg1('rftools:textures/gui/booster.png')
        energybar('energybar') {
            hint(8,101,10,76)
            showtext(false)
        }
        imagechoicelabel('redstone') {
            channel('redstone')
            desired(16,16)
            hint(171,76,-1,-1)
            image('rftools:textures/gui/guielements.png')
            dim(0,0,256,256)
            choices {
                choice('Ignored') {
                    uv(0,0)
                    tooltips('gui.rftools.common.redstone_mode_ignored')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('Off') {
                    uv(16,0)
                    tooltips('gui.rftools.common.redstone_mode_off_to_activate')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('On') {
                    uv(32,0)
                    tooltips('gui.rftools.common.redstone_mode_on_to_activate')
                    image('rftools:textures/gui/guielements.png')
                }
            }
        }
    }
}
