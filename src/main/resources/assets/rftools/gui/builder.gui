                        choice('Copy') {
                            tooltips('gui.rftools.builder.mode.copy.tip')
                        }
                        choice('Move') {
                            tooltips('gui.rftools.builder.mode.move.tip')
                        }
                        choice('Swap') {
                            tooltips('gui.rftools.builder.mode.swap.tip')
                        }
                        choice('Back') {
                            tooltips('gui.rftools.builder.mode.back.tip')
                        }
