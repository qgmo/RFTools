    container {
        slot('specificitem') {
            items('rftools:space_chamber_card','rftools:shape_card')
            pos(100,10)
        }
        slot('specificitem') {
            items('rftools:filter_module')
            pos(84,46)
        }
        playerslots(10,70)
    }
    window {
        size(180,152)

        event('rotate','builder.setRotate')
        event('mode','builder.setMode')

        action('restart','restart')

        bind('redstone','rsmode')
        bind('silent','silent')
        bind('entities','entities')
        bind('wait','wait')
        bind('loop','loop')
        bind('hilight','hilight')
        bind('support','support')

        panel('','positional') {
            bg1('rftools:textures/gui/builder.png')
            energybar('energybar') {
                hint(10,6,8,59)
                showtext(false)
            }
            panel('','positional') {
                hint(19,6,61,59)
                bgthickness(-2)
                bgfilled1(-7631989)
                choicelabel('mode') {
                    channel('mode')
                    hint(9,4,42,14)
                    enableon('validcard')
                    tooltips('gui.rftools.builder.mode.tip')
