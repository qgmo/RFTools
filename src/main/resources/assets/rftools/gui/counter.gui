window {
    size(200,30)

    event('counter','counter.setCounter')
    event('current','counter.setCurrent')

    panel('','vertical') {
        bgthickness(2)
        panel('','horizontal') {
            label('','gui.rftools.counter.label.text')
            textfield('counter') {
                channel('counter')
                tooltips('gui.rftools.counter.counter.tip')
            }
            label('','gui.rftools.counter.label.text_2')
            textfield('current') {
                channel('current')
                tooltips('gui.rftools.counter.current.tip')
            }
        }
    }
}
