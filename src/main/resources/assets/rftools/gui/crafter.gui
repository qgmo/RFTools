            dim(48,0,256,256)
            choices {
                choice('Slow') {
                    uv(48,0)
                    tooltips('gui.rftools.crafter.speed.slow.tip')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('Fast') {
                    uv(64,0)
                    tooltips('gui.rftools.crafter.speed.fast.tip')
                    image('rftools:textures/gui/guielements.png')
                }
            }
        }
        button('','R') {
            channel('remember')
            hint(148,74,18,16)
            tooltips('gui.rftools.crafter.remember_the_current_items_in.tip')
        }
        button('','F') {
            channel('forget')
            hint(168,74,18,16)
