window {
    size(256,238)

    event('remember','crafter.remember')
    event('forget','crafter.forget')
    event('redstone','crafter.setRsMode')
    event('speed','crafter.setMode')

    panel('','positional') {
        bg1('rftools:textures/gui/crafter.png')
        energybar('energybar') {
            hint(12,141,10,76)
            showtext(false)
        }
        choicelabel('keep') {
            hint(148,7,41,14)
            choices {
                choice('All') {
                    tooltips('gui.rftools.crafter.keep.all.tip')
                }
                choice('Keep') {
                    tooltips('gui.rftools.crafter.keep.keep.tip')
                }
            }
        }
        choicelabel('internal') {
            hint(148,24,41,14)
            tooltips('gui.rftools.crafter.internal.tip')
            choices {
                choice('Ext') {
                    tooltips('gui.rftools.crafter.internal.ext.tip')
                }
                choice('Int') {
                    tooltips('gui.rftools.crafter.internal.int.tip')
                }
                choice('ExtC') {
                    tooltips('gui.rftools.crafter.internal.extc.tip')
                }
            }
        }
        widgetlist('recipes') {
            channel('select')
            hint(10,7,126,84)
            bgthickness(-1)
            bgfilled1(-7631989)
        }
        slider {
            hint(137,7,10,84)
            scrollable('recipes')
        }
        button('apply','gui.rftools.crafter.apply.text') {
            channel('apply')
            hint(212,65,34,16)
            tooltips('gui.rftools.crafter.apply.tip')
        }
        imagechoicelabel('redstone') {
            channel('redstone')
            hint(31,186,16,16)
            image('rftools:textures/gui/guielements.png')
            dim(0,0,256,256)
            choices {
                choice('Ignored') {
                    uv(0,0)
                    tooltips('gui.rftools.common.redstone_mode_ignored')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('Off') {
                    uv(16,0)
                    tooltips('gui.rftools.common.redstone_mode_off_to_activate')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('On') {
                    uv(32,0)
                    tooltips('gui.rftools.common.redstone_mode_on_to_activate')
                    image('rftools:textures/gui/guielements.png')
                }
            }
        }
        imagechoicelabel('speed') {
            channel('speed')
