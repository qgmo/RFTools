window {
    size(220,30)

    event('name','elevator.setName')

    panel('','vertical') {
        bgthickness(2)
        panel('','horizontal') {
            label('','gui.rftools.common.name')
            textfield('name') {
                channel('name')
                tooltips('gui.rftools.elevator.name.tip')
            }
        }
    }
}
