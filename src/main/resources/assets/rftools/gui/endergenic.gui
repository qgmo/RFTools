window {
    size(190,110)
    panel('','vertical') {
        bgthickness(2)
        energybar('energybar') {
            desired(-1,12)
            bgthickness(1)
            horizontal(true)
        }
        label('','gui.rftools.endergenic.label.text') {
            horizalign('ALIGN_LEFT')
        }
        panel('','horizontal') {
            label('','gui.rftools.endergenic.label.text_2') {
                desired(70,-1)
            }
            textfield('lastrft') {
                desired(90,14)
            }
        }
        panel('','horizontal') {
            label('','gui.rftools.endergenic.label.text_3') {
                desired(70,-1)
            }
            textfield('lastlost') {
                desired(90,14)
            }
        }
        panel('','horizontal') {
            label('','gui.rftools.endergenic.label.text_4') {
                desired(70,-1)
            }
            textfield('lastlaunched') {
                desired(90,14)
            }
        }
        panel('','horizontal') {
            label('','gui.rftools.endergenic.label.text_5') {
                desired(70,-1)
            }
            textfield('lastopp') {
                desired(90,14)
            }
        }
    }
}
