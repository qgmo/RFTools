window {
    size(140,30)

    event('mode', 'endermonitor.setMode')

    panel('','vertical') {
        bgthickness(2)
        panel('','horizontal') {
            label('','gui.rftools.endermonitor.label.text')
            choicelabel('mode') {
                channel('mode')
                desired(80,13)
                choices {
                    choice('Lost Pearl') {
                        tooltips('gui.rftools.endermonitor.mode.lost_pearl.tip')
                    }
                    choice('Pearl Fired') {
                        tooltips('gui.rftools.endermonitor.mode.pearl_fired.tip')
                    }
                    choice('Pearl Arrived') {
                        tooltips('gui.rftools.endermonitor.mode.pearl_arrived.tip')
                    }
                }
            }
        }
    }
}
