container {
    slot('input') {
        pos(7,8)
        dim(1,7)
    }
    playerslots(27,142)
}
window {
    size(194,224)

    event('redstone','env.setRsMode')
    event('radius','env.setRadius')

    panel('','positional') {
        bg1('rftools:textures/gui/environmentalcontroller.png')
        panel('','vertical') {
            hint(28,6,161,37)
            bgthickness(-2)
            bgfilled1(-7631989)
            panel('','horizontal') {
                desired(-1,16)
                label('','gui.rftools.environmental.label.text')
                slider {
                    horizontal(true)
                    minimumknob(12)
                    scrollable('radius')
                }
                scrollablelabel('radius','57') {
                    channel('radius')
                    desired(24,-1)
                    realmin(5)
                }
            }
            panel('','horizontal') {
                desired(-1,17)
                label('','gui.rftools.environmental.label.text_2')
                textfield('miny') {
                    channel('miny')
                }
                textfield('maxy') {
                    channel('maxy')
                }
            }
            spacing(0)
        }
        panel('','horizontal') {
            hint(25,42,167,78)
            widgetlist('players') {
                bgthickness(-1)
                bgfilled1(-7631989)
            }
            slider {
                scrollable('players')
                desired(11,-1)
            }
            spacing(1)
            horizmargin(3)
        }
        panel('','horizontal') {
            hint(26,120,162,16)
            choicelabel('mode') {
                channel('mode')
                desired(40,15)
                choices {
                    choice('BL') {
                        tooltips('gui.rftools.environmental.mode.bl.tip')
                    }
                    choice('WL') {
                        tooltips('gui.rftools.environmental.mode.wl.tip')
                    }
                    choice('Mobs') {
                        tooltips('gui.rftools.environmental.mode.mobs.tip')
                    }
                    choice('Host') {
                        tooltips('gui.rftools.environmental.mode.host.tip')
                    }
                    choice('Pass') {
                        tooltips('gui.rftools.environmental.mode.pass.tip')
                    }
                    choice('All') {
                        tooltips('gui.rftools.environmental.mode.all.tip')
                    }
                }
            }
            button('add','+') {
                channel('add')
                enableon('name')
                desired(-1,15)
                tooltips('gui.rftools.environmental.add.tip')
            }
            button('del','-') {
                channel('del')
                enableon('selected')
                desired(-1,15)
                tooltips('gui.rftools.environmental.del.tip')
            }
            textfield('name')
            imagechoicelabel('redstone') {
                channel('redstone')
                desired(16,16)
                image('rftools:textures/gui/guielements.png')
                dim(16,0,256,256)
                choices {
                    choice('Ignored') {
                        uv(0,0)
                        tooltips('gui.rftools.common.redstone_mode_ignored')
                        image('rftools:textures/gui/guielements.png')
                    }
                    choice('Off') {
                        uv(16,0)
                        tooltips('gui.rftools.common.redstone_mode_off_to_activate')
                        image('rftools:textures/gui/guielements.png')
                    }
                    choice('On') {
                        uv(32,0)
                        tooltips('gui.rftools.common.redstone_mode_on_to_activate')
                        image('rftools:textures/gui/guielements.png')
                    }
                }
            }
            spacing(1)
            horizmargin(1)
            vertmargin(0)
        }
        energybar('energybar') {
            hint(8,141,10,76)
            showtext(false)
        }
    }
}
