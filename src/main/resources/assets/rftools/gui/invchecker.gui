container {
    slot('ghost') {
        pos(154,24)
    }
    playerslots(10,70)
}

window {
    size(180,152)

    event('amount','inv.setCounter')
    event('slot','inv.setSlot')
    event('meta','inv.setUseMeta')
    event('ore','inv.setOreDict')

    panel('','positional') {
        bg1('rftools:textures/gui/invchecker.png')
        label('','gui.rftools.invchecker.label.text') {
            hint(10,3,50,14)
            horizalign('ALIGN_LEFT')
        }
        textfield('slot') {
            channel('slot')
            hint(60,3,80,14)
            tooltips('gui.rftools.invchecker.slot.tip')
        }
        label('','gui.rftools.common.amount') {
            hint(10,19,50,14)
            horizalign('ALIGN_LEFT')
        }
        textfield('amount') {
            channel('amount')
            hint(60,19,80,14)
            tooltips('gui.rftools.common.set_the_amount_of_items_in_slot')
        }
        label('','gui.rftools.invchecker.label.text_3') {
            hint(10,35,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('meta') {
            channel('meta')
            hint(60,35,80,14)
            choices {
                choice('Ignore') {
                    tooltips('gui.rftools.invchecker.meta.ignore.tip')
                }
                choice('Match') {
                    tooltips('gui.rftools.invchecker.meta.match.tip')
                }
            }
        }
        label('','gui.rftools.common.oredict') {
            hint(10,51,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('ore') {
            channel('ore')
            hint(60,51,80,14)
            choices {
                choice('Ignore') {
                    tooltips('gui.rftools.common.ingore_ore_dictionary')
                }
                choice('Use') {
                    tooltips('gui.rftools.common.use_ore_dictionary_matching')
                }
            }
        }
    }
}
