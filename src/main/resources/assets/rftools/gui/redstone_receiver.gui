window {
    size(168,20)

    event('analog','receiver.setAnalog')

    panel('','vertical') {
        bgthickness(2)
        togglebutton('analog','gui.rftools.redstone_receiver.analog.text') {
            channel('analog')
            desired(160,16)
            tooltips('gui.rftools.redstone_receiver.analog.tip')
            check(true)
        }
    }
}
