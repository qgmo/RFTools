window {
    size(244,206)
    panel('','positional') {
        bg1('rftools:textures/gui/securitymanager.png')
        panel('','horizontal') {
            hint(72,5,168,96)
            widgetlist('players') {
                enableon('card')
                bgthickness(-1)
                bgfilled1(-7631989)
            }
            slider {
                desired(10,-1)
                scrollable('players')
            }
            spacing(1)
            horizmargin(3)
        }
        panel('','horizontal') {
            desired(-1,16)
            hint(72,100,168,14)
            textfield('name') {
                desired(-1,15)
                enableon('card')
            }
            button('addbutton','gui.rftools.common.add') {
                desired(34,14)
                enableon('card')
                tooltips('gui.rftools.common.add_a_player_to_the_access_list')
            }
            button('delbutton','gui.rftools.common.del') {
                desired(34,14)
                enableon('card')
                tooltips('gui.rftools.common.remove_the_selected_player_from_the_access')
            }
            spacing(1)
            horizmargin(3)
        }
        textfield('channelname') {
            hint(8,27,60,14)
            enableon('card')
        }
        imagechoicelabel('blacklistmode') {
            hint(10,44,16,16)
            enableon('card')
            tooltips('gui.rftools.common.black_or_whitelist_mode')
            image('rftools:textures/gui/guielements.png')
            dim(240,32,256,256)
            choices {
                choice('White') {
                    uv(240,32)
                    tooltips('gui.rftools.common.whitelist_players')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('Black') {
                    uv(224,32)
                    tooltips('gui.rftools.common.blacklist_players')
                    image('rftools:textures/gui/guielements.png')
                }
            }
        }
    }
}
