container {
    slot('ghost') {
        pos(154,24)
    }
    playerslots(10,70)
}

window {
    size(180,152)

    event('number','sensor.setNumber')
    event('type','sensor.setType')
    event('area','sensor.setArea')
    event('group','sensor.setGroup')

    panel('','positional') {
        bg1('rftools:textures/gui/sensor.png')
        label('','gui.rftools.sensor.label.text') {
            hint(10,3,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('area') {
            channel('area')
            hint(60,19,80,14)
            choices {
                choice('Area 1') {
                    tooltips('gui.rftools.sensor.area.area_1.tip')
                }
                choice('Area 3') {
                    tooltips('gui.rftools.sensor.area.area_3.tip')
                }
                choice('Area 5') {
                    tooltips('gui.rftools.sensor.area.area_5.tip')
                }
                choice('Area 3x3') {
                    tooltips('gui.rftools.sensor.area.area_3x3.tip')
                }
                choice('Area 5x5') {
                    tooltips('gui.rftools.sensor.area.area_5x5.tip')
                }
                choice('Area 7x7') {
                    tooltips('gui.rftools.sensor.area.area_7x7.tip')
                }
            }
        }
        label('','gui.rftools.sensor.label.text_2') {
            hint(10,19,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('type') {
            channel('type')
            hint(60,3,80,14)
            choices {
                choice('Block') {
                    tooltips('gui.rftools.sensor.type.block.tip')
                }
                choice('Fluid') {
                    tooltips('gui.rftools.sensor.type.fluid.tip')
                }
                choice('Growth') {
                    tooltips('gui.rftools.sensor.type.growth.tip')
                }
                choice('Entities') {
                    tooltips('gui.rftools.sensor.type.entities.tip')
                }
                choice('Players') {
                    tooltips('gui.rftools.sensor.type.players.tip')
                }
                choice('Hostile') {
                    tooltips('gui.rftools.sensor.type.hostile.tip')
                }
                choice('Passive') {
                    tooltips('gui.rftools.sensor.type.passive.tip')
                }
            }
        }
        label('','gui.rftools.sensor.label.text_3') {
            hint(10,35,50,14)
            horizalign('ALIGN_LEFT')
        }
        choicelabel('group') {
            channel('group')
            hint(60,35,80,14)
            enableon('group')
            choices {
                choice('One') {
                    tooltips('gui.rftools.sensor.group.one.tip')
                }
                choice('All') {
                    tooltips('gui.rftools.sensor.group.all.tip')
                }
            }
        }
        label('','gui.rftools.sensor.label.text_4') {
            hint(10,51,50,14)
            horizalign('ALIGN_LEFT')
        }
        textfield('number') {
            channel('number')
            hint(60,51,80,14)
            enableon('number')
            tooltips('gui.rftools.sensor.number.tip')
        }
    }
}
