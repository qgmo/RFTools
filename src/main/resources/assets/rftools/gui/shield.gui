window {
    size(256,224)
    panel('','positional') {
        bg1('rftools:textures/gui/shieldprojector.png')
        energybar {
            hint(12,141,10,76)
            showtext(false)
        }
        choicelabel('visibility') {
            channel('visibility')
            hint(25,161,54,14)
            choices {
                choice('Invisible') {
                    tooltips('gui.rftools.common.shield_is_completely_invisible')
                }
                choice('Shield') {
                    tooltips('gui.rftools.common.default_shield_texture')
                }
                choice('Mimic') {
                    tooltips('gui.rftools.common.use_the_texture_from_the_supplied_block')
                }
                choice('Transp') {
                    tooltips('gui.rftools.common.transparent_shield_texture')
                }
                choice('Solid') {
                    tooltips('gui.rftools.common.solid_shield_texture')
                }
            }
        }
        button('','gui.rftools.common.set') {
            channel('camo')
            hint(46,142,30,16)
            tooltips('gui.rftools.common.set_the_camouflage_block')
        }
        imagechoicelabel('redstone') {
            channel('redstone')
            hint(62,200,16,16)
            image('rftools:textures/gui/guielements.png')
            dim(0,0,256,256)
            choices {
                choice('Ignored') {
                    uv(0,0)
                    tooltips('gui.rftools.common.redstone_mode_ignored')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('Off') {
                    uv(16,0)
                    tooltips('gui.rftools.common.redstone_mode_off_to_activate')
                    image('rftools:textures/gui/guielements.png')
                }
                choice('On') {
                    uv(32,0)
                    tooltips('gui.rftools.common.redstone_mode_on_to_activate')
                    image('rftools:textures/gui/guielements.png')
                }
            }
        }
        panel('','horizontal') {
            hint(12,10,154,124)
            bgfilled1(-6381922)
            widgetlist('filters') {
                channel('filters')
                desired(-1,120)
                bgthickness(-1)
                bgfilled1(-7631989)
            }
            slider {
                desired(11,120)
                scrollable('filters')
            }
            spacing(1)
            horizmargin(3)
        }
        choicelabel {
            hint(170,12,80,14)
            choices {
                choice('Pass') {
                    tooltips('gui.rftools.common.entity_that_matches_this_filter_can_pass_2')
                }
                choice('Solid') {
                    tooltips('gui.rftools.common.entity_that_matches_this_filter_cannot_pass_2')
                }
                choice('Damage') {
                    tooltips('gui.rftools.common.entity_that_matches_this_filter_can_pass')
                }
                choice('SolDmg') {
                    tooltips('gui.rftools.common.entity_that_matches_this_filter_cannot_pass')
                }
            }
        }
        choicelabel {
            hint(170,28,80,14)
            choices {
                choice('All') {
                    tooltips('gui.rftools.common.matches_everything')
                }
                choice('Passive') {
                    tooltips('gui.rftools.common.matches_passive_mobs')
                }
                choice('Hostile') {
                    tooltips('gui.rftools.common.matches_hostile_mobs')
                }
                choice('Item') {
                    tooltips('gui.rftools.common.matches_items')
                }
                choice('Player') {
                    tooltips('gui.rftools.common.matches_players_optionally_named')
                }
            }
        }
        textfield {
            hint(170,44,80,14)
            tooltips('gui.rftools.common.optional_player_name')
        }
        panel('','positional') {
            hint(170,58,80,43)
            bgthickness(-2)
            bgfilled1(-7631989)
            button('','gui.rftools.common.add') {
                channel('addfilter')
                hint(4,6,36,14)
                tooltips('gui.rftools.common.add_selected_filter')
            }
            button('','gui.rftools.common.del') {
                channel('delfilter')
                hint(39,6,36,14)
                tooltips('gui.rftools.common.delete_selected_filter')
            }
            button('','gui.rftools.common.up') {
                channel('upfilter')
                hint(4,22,36,14)
                tooltips('gui.rftools.common.move_filter_up')
            }
            button('','gui.rftools.common.down') {
                channel('downfilter')
                hint(39,22,36,14)
                tooltips('gui.rftools.common.move_filter_down')
            }
        }
        choicelabel('damage') {
            channel('damage')
            hint(170,102,80,14)
            choices {
                choice('Generic') {
                    tooltips('gui.rftools.common.generic_damage_type')
                }
                choice('Player') {
                    tooltips('gui.rftools.common.damage_as_done_by_a_player')
                }
            }
        }
        colorselector('color') {
            channel('color')
            hint(25,177,30,16)
            tooltips('gui.rftools.common.color_for_the_shield')
        }
        label('','gui.rftools.common.looting') {
            hint(160,118,60,18)
            tooltips('gui.rftools.common.insert_dimensional_shards_for_looting_bonus')
            horizalign('ALIGN_RIGHT')
        }
        togglebutton('light','L') {
            channel('light')
            hint(56,177,23,16)
            tooltips('gui.rftools.common.if_pressed_light_is_blocked_by_the_shield')
            check(true)
        }
    }
}
