window {
    size(168,48)

    event('delay','timer.setDelay')
    event('pauses','timer.setPauses')

    panel('','vertical') {
        bgthickness(2)
        panel('','horizontal') {
            label('','gui.rftools.common.delay')
            textfield('delay') {
                channel('delay')
                tooltips('gui.rftools.timer.delay.tip')
            }
        }
        togglebutton('pauses','gui.rftools.timer.pauses.text') {
            channel('pauses')
            desired(-1,16)
            check(true)
        }
    }
}
