# Messages
message.rftools.shiftmessage=<按住Shift>
message.rftools.coalgenerator=\
    @f这台机器用煤炭或木炭发电\n\
    @f（%s RF/t）\n\
    @e注入加成：发电量更高，\n\
    @e且单份燃料燃烧更久
message.rftools.booster=\
    @f这个方块会给正站在它上方\n\
    @f的实体一个临时效果\n\
    @e注入加成：降低耗电
message.rftools.infuser=\
    @f用这台机器可以通过多种方式\n\
    @f改良 RFTools 里的大多数其他机器，\n\
    @f需要消耗空间碎片。\n\
    @e注入加成：降低耗电
message.rftools.itemfilter=\
    @a内容：%s 组\n\
    @f这个方块可以把物品从任意一面\n\
    @f导向任意另一面，用来做采石场、\n\
    @f林场、刷怪塔等的物品过滤器
message.rftools.security_manager=\
    @a内容：%s 组\n\
    @f这个方块用来管理你的安全卡
message.rftools.builder=\
    @f这个方块可以采掘区域、抽取流体、\n\
    @f移动/复制/交换结构、收集物品和经验、\n\
    @f移动实体、建造结构等等\n\
    @e注入加成：降低耗电并\n\
    @e提高速度
message.rftools.elevator=\
    @f这台机器需要放在某一层，并朝向\n\
    @f移动平台所在的方向。\n\
    @f只有最底层的电梯需要供电\n\
    @e注入加成：降低耗电
message.rftools.rf_monitor=\
    @f这个装置监视相邻机器里的 RF 量\n\
    @f（在界面中选择机器）。当能量高于\n\
    @f或低于某个值时，它还可以\n\
    @f发出红石信号
message.rftools.liquid_monitor=\
    @f这个装置监视相邻机器里的流体量\n\
    @f（在界面中选择机器）。当流体高于\n\
    @f或低于某个值时，它还可以\n\
    @f发出红石信号
message.rftools.relay=\
    @f这个装置可以（根据红石信号）\n\
    @f限制通过它的 RF 量。用它可以在\n\
    @f电力不足时降低（甚至停止）\n\
    @f一些机器的运转
message.rftools.composer=\
    @f这个方块可以把其他塑形卡片\n\
    @f组合起来，做出更复杂的\n\
    @f供建造机或护盾使用的\n\
    @f塑形卡片
message.rftools.locator=\
    @f把这个方块放在扫描器上面，\n\
    @f可以让扫描器耗电定位\n\
    @f实体和机器
message.rftools.projector=\
    @f这个方块可以把塑形卡片的\n\
    @f内容像全息影像一样投影出来
message.rftools.scanner=\
    @2扫描 ID：%s\n\
    @f这个方块可以扫描一片区域，并链接到\n\
    @f供建造机或护盾使用的塑形卡片。\n\
    @f得到的塑形卡片也可以\n\
    @f用在构建器中
message.rftools.remote_scanner=\
    @2扫描 ID：%s\n\
    @f这个方块可以扫描一片区域，并链接到\n\
    @f供建造机或护盾使用的塑形卡片。\n\
    @f得到的塑形卡片也可以\n\
    @f用在构建器中\n\
    @6这个版本可以通过位于它上方、\n\
    @6已拨号的物质传输器\n\
    @6进行扫描
message.rftools.spawner=\
    @f这个方块可以生成生物。它需要对应种类\n\
    @f的注射器、RF 电力，以及\n\
    @f充能物质束\n\
    @e注入加成：降低耗电
message.rftools.environmental_controller=\
    @a范围：半径 %s（%s 到 %s 之间）\n\
    @f用各种模块控制你周围的环境，\n\
    @f比如再生、速度等等\n\
    @e注入加成：降低耗电
message.rftools.endergenic=\
    @f用末影珍珠发电。至少需要两台\n\
    @f发电机才能工作，而且搭建比较复杂，\n\
    @f时机非常关键\n\
    @e注入加成：提高发电量，\n\
    @e并减少持有珍珠时的能量损耗
message.rftools.pearl_injector=\
    @a内容：%s 组\n\
    @f收到红石信号时，会向相邻的\n\
    @f末影能发电机注入一颗末影珍珠
message.rftools.wire=\
    @f这个逻辑方块只是一根\n\
    @f没有延迟的红石线
message.rftools.timer=\
    @a延迟：%s\n\
    @f这个逻辑方块在一段时间后发出红石脉冲，\n\
    @f如果在此之前收到红石脉冲，\n\
    @f则不会发出
message.rftools.digit=\
    @f这个逻辑方块只是一个数码管，\n\
    @f显示红石输入的强度
message.rftools.analog=\
    @f这个逻辑方块可以对\n\
    @f模拟红石信号进行运算
message.rftools.sensor=\
    @f这个逻辑方块会根据它前方的\n\
    @f各种情况输出红石信号，比如方块放置、\n\
    @f作物生长阶段、实体数量等等
message.rftools.invchecker=\
    @f当物品栏格子里的物品数量超过\n\
    @f某个值时，这个逻辑方块会输出红石信号
message.rftools.threelogic=\
    @f这个逻辑方块可以对三个输入\n\
    @f进行各种逻辑运算
message.rftools.counter=\
    @a计数目标：%s\n\
    @a当前值：%s\n\
    @f这个逻辑方块对红石脉冲计数，\n\
    @f达到指定数量时发出信号
message.rftools.sequencer=\
    @a延迟：%s\n\
    @a模式：%s\n\
    @a位数：%s\n\
    @f这个逻辑方块按你在界面中设定的\n\
    @f图案依次发出一串红石信号

