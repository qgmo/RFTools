# Messages
message.rftools.shiftmessage=<按住Shift>
message.rftools.coalgenerator=\
    @f這臺機器用煤炭或木炭發電\n\
    @f（%s RF/t）\n\
    @e注入加成：發電量更高，\n\
    @e且單份燃料燃燒更久
message.rftools.booster=\
    @f這個方塊會給正站在它上方\n\
    @f的實體一個臨時效果\n\
    @e注入加成：降低耗電
message.rftools.infuser=\
    @f用這臺機器可以透過多種方式\n\
    @f改良 RFTools 裡的大多數其他機器，\n\
    @f需要消耗空間碎片。\n\
    @e注入加成：降低耗電
message.rftools.itemfilter=\
    @a內容：%s 組\n\
    @f這個方塊可以把物品從任意一面\n\
    @f導向任意另一面，用來做採石場、\n\
    @f林場、刷怪塔等的物品過濾器
message.rftools.security_manager=\
    @a內容：%s 組\n\
    @f這個方塊用來管理你的安全卡
message.rftools.builder=\
    @f這個方塊可以採掘區域、抽取流體、\n\
    @f移動/複製/交換結構、收集物品和經驗、\n\
    @f移動實體、建造結構等等\n\
    @e注入加成：降低耗電並\n\
    @e提高速度
message.rftools.elevator=\
    @f這臺機器需要放在某一層，並朝向\n\
    @f移動平臺所在的方向。\n\
    @f只有最底層的電梯需要供電\n\
    @e注入加成：降低耗電
message.rftools.rf_monitor=\
    @f這個裝置監視相鄰機器裡的 RF 量\n\
    @f（在介面中選擇機器）。當能量高於\n\
    @f或低於某個值時，它還可以\n\
    @f發出紅石訊號
message.rftools.liquid_monitor=\
    @f這個裝置監視相鄰機器裡的流體量\n\
    @f（在介面中選擇機器）。當流體高於\n\
    @f或低於某個值時，它還可以\n\
    @f發出紅石訊號
message.rftools.relay=\
    @f這個裝置可以（根據紅石訊號）\n\
    @f限制透過它的 RF 量。用它可以在\n\
    @f電力不足時降低（甚至停止）\n\
    @f一些機器的運轉
message.rftools.composer=\
    @f這個方塊可以把其他塑形卡片\n\
    @f組合起來，做出更復雜的\n\
    @f供建造機或護盾使用的\n\
    @f塑形卡片
message.rftools.locator=\
    @f把這個方塊放在掃描器上面，\n\
    @f可以讓掃描器耗電定位\n\
    @f實體和機器
message.rftools.projector=\
    @f這個方塊可以把塑形卡片的\n\
    @f內容像全息影像一樣投影出來
message.rftools.scanner=\
    @2掃描 ID：%s\n\
    @f這個方塊可以掃描一片區域，並連結到\n\
    @f供建造機或護盾使用的塑形卡片。\n\
    @f得到的塑形卡片也可以\n\
    @f用在構建器中
message.rftools.remote_scanner=\
    @2掃描 ID：%s\n\
    @f這個方塊可以掃描一片區域，並連結到\n\
    @f供建造機或護盾使用的塑形卡片。\n\
    @f得到的塑形卡片也可以\n\
    @f用在構建器中\n\
    @6這個版本可以透過位於它上方、\n\
    @6已撥號的物質傳輸器\n\
    @6進行掃描
message.rftools.spawner=\
    @f這個方塊可以生成生物。它需要對應種類\n\
    @f的注射器、RF 電力，以及\n\
    @f充能物質束\n\
    @e注入加成：降低耗電
message.rftools.environmental_controller=\
    @a範圍：半徑 %s（%s 到 %s 之間）\n\
    @f用各種模組控制你周圍的環境，\n\
    @f比如再生、速度等等\n\
    @e注入加成：降低耗電
message.rftools.endergenic=\
    @f用終界珍珠發電。至少需要兩臺\n\
    @f發電機才能工作，而且搭建比較複雜，\n\
    @f時機非常關鍵\n\
    @e注入加成：提高發電量，\n\
    @e並減少持有珍珠時的能量損耗
message.rftools.pearl_injector=\
    @a內容：%s 組\n\
    @f收到紅石訊號時，會向相鄰的\n\
    @f終界能發電機注入一顆終界珍珠
message.rftools.wire=\
    @f這個邏輯方塊只是一根\n\
    @f沒有延遲的紅石線
message.rftools.timer=\
    @a延遲：%s\n\
    @f這個邏輯方塊在一段時間後發出紅石脈衝，\n\
    @f如果在此之前收到紅石脈衝，\n\
    @f則不會發出
message.rftools.digit=\
    @f這個邏輯方塊只是一個數碼管，\n\
    @f顯示紅石輸入的強度
message.rftools.analog=\
    @f這個邏輯方塊可以對\n\
    @f模擬紅石訊號進行運算
message.rftools.sensor=\
    @f這個邏輯方塊會根據它前方的\n\
    @f各種情況輸出紅石訊號，比如方塊放置、\n\
    @f作物生長階段、實體數量等等
message.rftools.invchecker=\
    @f當物品欄格子裡的物品數量超過\n\
    @f某個值時，這個邏輯方塊會輸出紅石訊號
message.rftools.threelogic=\
    @f這個邏輯方塊可以對三個輸入\n\
    @f進行各種邏輯運算
message.rftools.counter=\
    @a計數目標：%s\n\
    @a當前值：%s\n\
    @f這個邏輯方塊對紅石脈衝計數，\n\
    @f達到指定數量時發出訊號
message.rftools.sequencer=\
    @a延遲：%s\n\
    @a模式：%s\n\
    @a位數：%s\n\
    @f這個邏輯方塊按你在介面中設定的\n\
    @f圖案依次發出一串紅石訊號

